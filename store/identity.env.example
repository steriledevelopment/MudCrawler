# Copy this file to store/identity.env and fill in the values from Partner Center:
#   your product > Product management > Product identity
IDENTITY_NAME="PUT.PackageIdentityName.HERE"            # Package/Identity/Name
PUBLISHER="CN=PUT-PUBLISHER-ID-HERE"                    # Package/Identity/Publisher  (a CN=GUID string)
PUBLISHER_DISPLAY_NAME="Your publisher display name"    # Package/Properties/PublisherDisplayName
DISPLAY_NAME="The Mud Crawler"                              # the product name you reserved
